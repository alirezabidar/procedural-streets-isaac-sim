                custom token[] inputs:renderProductPaths
                prepend token[] inputs:renderProductPaths.connect = </Render/PostProcess/SDGPipeline/PostProcessDispatcher.outputs:renderProductPaths>
            }

            over "Replicator_GenericModelOutputPtr"
            {
                custom uint inputs:exec
                prepend uint inputs:exec.connect = </Render/PostProcess/SDGPipeline/Replicator_PostProcessDispatch.outputs:exec>
                custom uint64 inputs:renderResults
                prepend uint64 inputs:renderResults.connect = </Render/PostProcess/SDGPipeline/Replicator_PostProcessDispatch.outputs:renderResults>
                custom token outputs:__device
                custom bool outputs:__do_array_copy
            }

            over "Replicator_IsaacExtractRTXSensorPointCloud"
            {
                custom int inputs:cudaDeviceIndex
                prepend int inputs:cudaDeviceIndex.connect = </Render/PostProcess/SDGPipeline/Replicator_GenericModelOutputPtr.outputs:cudaDeviceIndex>
                custom uint64 inputs:dataPtr
                prepend uint64 inputs:dataPtr.connect = </Render/PostProcess/SDGPipeline/Replicator_GenericModelOutputPtr.outputs:dataPtr>
                custom uint inputs:exec
                prepend uint inputs:exec.connect = </Render/PostProcess/SDGPipeline/Replicator_GenericModelOutputPtr.outputs:exec>
                custom token outputs:__device
                custom bool outputs:__do_array_copy
            }
        }
    }
